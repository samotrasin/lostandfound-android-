<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.item_details.ItemDetailsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/details_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#f5f5dc"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/detail_item_image"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/profile_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sample_item"
                    app:shapeAppearanceOverlay="@style/RoundImageView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/detail_item_type_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Found Item"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/detail_item_image"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Title Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detail_title_input_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Title"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/black"
                    app:boxStrokeColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/detail_item_type_header"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detail_title_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:enabled="false"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Description Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detail_description_input_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Description"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/black"
                    app:boxStrokeColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/detail_title_input_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detail_description_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:minLines="2"
                        android:maxLines="4"
                        android:enabled="false"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Location Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detail_location_input_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Location"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/black"
                    app:boxStrokeColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/detail_description_input_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detail_location_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:enabled="false"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Category Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detail_category_input_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Category"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/black"
                    app:boxStrokeColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/detail_location_input_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detail_category_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:enabled="false"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Date Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detail_date_input_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Date"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/black"
                    app:boxStrokeColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/detail_category_input_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detail_found_date_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:enabled="false"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Owner field (for returned items) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detail_owner_input_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Owner"
                    android:visibility="gone"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/black"
                    app:boxStrokeColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/detail_date_input_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detail_owner_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:enabled="false"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Finder field (for returned items) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/detail_finder_input_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Finder"
                    android:visibility="gone"
                    app:boxStrokeWidth="2dp"
                    app:hintTextColor="@color/black"
                    app:boxStrokeColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/detail_owner_input_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/detail_finder_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:enabled="false"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_back"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#00ADCC"
                    android:text="Back to List"
                    android:textColor="#ffffff"
                    app:cornerRadius="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/detail_finder_input_layout" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
