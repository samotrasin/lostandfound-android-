<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.post_items.PostItemFragment"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/post_item_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#f5f5dc"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/post_item_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/item_image_view"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/profile_description"
                android:scaleType="fitCenter"
                android:src="@drawable/sample_item"
                app:shapeAppearanceOverlay="@style/RoundImageView"
                app:layout_constraintTop_toTopOf="@id/post_item_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/item_lost_or_found_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/lost_or_found"
                android:textColorHint="#B4c8d2"
                app:boxStrokeColor="@color/my_default_color"
                app:cursorColor="@color/my_default_color"
                app:hintTextColor="@color/my_default_color"
                app:layout_constraintTop_toBottomOf="@id/item_image_view"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/item_lost_or_found_input_field"
                    android:layout_width="match_parent"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:layout_height="55dp"
                    android:textColor="@color/black"
                    android:focusable="false"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/item_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/item_title_hint"
                android:textColorHint="#B4c8d2"
                app:boxStrokeColor="@color/my_default_color"
                app:cursorColor="@color/my_default_color"
                app:hintTextColor="@color/my_default_color"
                app:layout_constraintTop_toBottomOf="@+id/item_lost_or_found_input"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/found_date_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/found_date"
                android:textColorHint="#B4c8d2"
                app:boxStrokeColor="@color/my_default_color"
                app:cursorColor="@color/my_default_color"
                app:hintTextColor="@color/my_default_color"
                app:layout_constraintTop_toBottomOf="@+id/item_title_input"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/item_description_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/item_description_hint"
                android:textColorHint="#B4c8d2"
                app:boxStrokeColor="@color/my_default_color"
                app:cursorColor="@color/my_default_color"
                app:hintTextColor="@color/my_default_color"
                app:layout_constraintTop_toBottomOf="@+id/found_date_input">

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:textColor="@color/black"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:maxLines="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/item_location_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/item_location_hint"
                android:textColorHint="#B4c8d2"
                app:boxStrokeColor="@color/my_default_color"
                app:cursorColor="@color/my_default_color"
                app:hintTextColor="@color/my_default_color"
                app:layout_constraintTop_toBottomOf="@+id/item_description_input">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/item_location_input_field"
                    android:layout_width="match_parent"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:layout_height="55dp"
                    android:textColor="@color/black"
                    android:focusable="false"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/item_category_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/item_category_hint"
                android:textColorHint="#B4c8d2"
                app:boxStrokeColor="@color/my_default_color"
                app:cursorColor="@color/my_default_color"
                app:hintTextColor="@color/my_default_color"
                app:layout_constraintTop_toBottomOf="@+id/item_location_input">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"/>
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_item_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:backgroundTint="#00ADCC"
                android:text="@string/post_item_button"
                android:textColor="#ffffff"
                app:cornerRadius="16dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                app:layout_constraintTop_toBottomOf="@+id/item_category_input"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                android:onClick="onCancelButtonClick"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#f5f5dc"
                android:text="@string/cancel_button"
                android:textColor="#ff0000"
                app:cornerRadius="16dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                app:strokeColor="#ff0000"
                app:strokeWidth="2dp"
                app:layout_constraintTop_toBottomOf="@+id/post_item_button"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>